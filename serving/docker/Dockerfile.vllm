# syntax=docker/dockerfile:1.6
#
# NemoClaw-Thor vLLM Container — v9 generation
# Builds vLLM + FlashInfer from source for Jetson AGX Thor (sm110 / Blackwell).
#
# Adapted from spark-vllm-docker (sm121) — stripped of Ray/cluster logic,
# retargeted for single-node Thor with CUDA 13.0 and JetPack 7.1.
#
# v9 changes vs v8.1 (2026-05-21 staging):
#   - BUMPED vLLM v0.20.1 → v0.22.0. Major bump (skipping v0.21 as a staging
#     waypoint; v0.22 supersedes it and is the first release with the FP8-KV
#     Cutlass batch-invariance perf path our cosmos-reason2-8b production
#     profile (BF16 weights + FP8 KV) directly benefits from. Headline gains:
#     batch-invariant Cutlass FP8 +28.9% E2E latency on the FP8-KV path
#     (#41xxx-vintage Cutlass FP8 work); CutlassFP8 padding pre-processing
#     +13.5% TTFT; Qwen3.5 ViT full CUDA graph (direct cosmos-reason2 vision
#     tower path); FlashInfer metadata for Qwen2.5-VL vision attention
#     (adjacent family — likely transfers to Qwen3-VL family at runtime).
#     Stability: stream-aware allocator free callback (memory fragmentation
#     fix for long-running gateway services like ours), MRv2 correctness
#     fixes (logprob_token_ids, prompt-logprobs size). Tool calling:
#     Qwen3Coder anyOf/oneOf/$ref resolution + shared coerce_to_schema_type
#     (composes with the manyforge MCP wrapper's union-type schemas).
#     Multi-tier KV cache offloading w/ Python filesystem secondary tier
#     (hardware-agnostic; potential relief for long composer-assistant
#     sessions). Runai-streamer weight loading covers Qwen3.5/MTP/Qwen3-VL.
#     Carries forward 0.21 wins we previously planned: Qwen3-VL deepstack
#     heavy-load fix (matches cosmos-reason2-8b production), FP8-on-Thor
#     formalization (PR #39712 — removes our runtime SM-guard workarounds),
#     streaming tool dispatch with `required` and named tool choice (#40700,
#     #41110 — upstream primitive for Bridge Tier 1.1), XGrammar 0.2.0
#     structural tags for strict tool calling (#40894). Breaking changes
#     (both benign for us): C++20 compiler requirement (GCC 13 in our base
#     image supports it); transformers v4 deprecation (we're already on v5).
#   - BUMPED FlashInfer v0.6.10 → v0.6.12. The headline change for our stack
#     is "improved XQA kernel fixes for multi-iteration scenarios" — the XQA
#     FP8-KV decode path connects directly to the FlashRT-on-Thor transferable
#     optimization identified during the audit (FlashRT vendored a FlashInfer
#     XQA native FP8-KV kernel; the upstream fix in 0.6.12 may make that path
#     reachable through vLLM's backend selection on cosmos-reason2-8b decode).
#     Also: per-token NVFP4 quantization kernel perf optimization (applies to
#     all our NVFP4 profiles: 35B-A3B, 27B-distilled-v2, Gemma 4 Turbo);
#     "limit sm110 builds to aarch64" CI work signals Thor-specific build
#     maturity. NOTE: vLLM 0.22 bundles 0.6.11.post2 as its dependency pin;
#     we override to 0.6.12 here — same override pattern as the wheel-cache
#     management documented in PATCHES-AUDIT.md.
#   - BUMPED flash-attn-4 4.0.0b12 → 4.0.0b15. b15 (2026-05-27) explicitly
#     extends SM gating to recognize SM110a as part of the Blackwell family
#     ("Include sm_110 in Blackwell-family arch gating"). First commit-level
#     signal of first-class Thor support — resolves any "kernel selection
#     fell through to fallback" cases that previously surfaced as opaque
#     perf cliffs. b13/b14 carry varlen blocksparsity, ROCm-Windows build
#     fixes, varlen-paged-KV split-config fixes — rolling fix tail.
#   - BUMPED transformers 5.8.0 → 5.9.0. Headline for our stack: "support
#     for custom field prefilling (reasoning_content, thinking, etc.) in
#     chat template handling" — template-side primitive for the Dynamo-style
#     reasoning-block preservation pattern Bridge Tier 2 work targets.
#     With 5.9.0 the bridge can opt into reasoning_content prefill via
#     chat_template_kwargs (subject to per-model template support).
#     Other: Gemma4 input embedding fixes; SAM3 vision-embedding breaking
#     change (not applicable — we don't run SAM3).
#   - BUMPED nvidia-cudnn-cu13 9.21.1.3 → 9.23.0.39 (both stages). Single
#     minor + patch bump. Pin still subject to vLLM's transitive cuDNN
#     constraint at install time; documenting our requested version as
#     current latest is informational.
#   - BUMPED nvidia-cutlass-dsl 4.5.0 → 4.5.2. Two patch releases since v8.1
#     staging; accumulated bug fixes on the 4.5.0 stable line. No release-line
#     headline gain at our CUDA 13.0.3 (still gated on JetPack 7.2 / CUDA 13.2).
#   - BUMPED fastsafetensors 0.3.1 → 0.3.2. Single patch release; paired with
#     instanttensor 0.1.9 below for the fast-load codepath.
#   - BUMPED instanttensor 0.1.8 → 0.1.9. Single patch release; paired with
#     fastsafetensors 0.3.2 above for the --load-format instanttensor boot path.
#   - HELD nvidia-nvshmem-cu13 at 3.6.5 (still latest; transitive override
#     to 3.4.5 by vLLM's hard-pin remains).
#   - HELD apache-tvm-ffi at 0.1.11 (still latest; transitive override to
#     0.1.9 by vLLM's hard-pin remains).
#   - HELD triattention at @325297218a.
#   - HELD CUDA at 13.0.3-ubuntu24.04. JetPack 7.1 ships CUDA 13.0; container
#     CUDA ahead of host driver adds avoidable risk. Bump when JetPack 7.2
#     lands and Thor goes SBSA.
#   - HELD torch nightly at 2026-04-26+cu130. Tied to the CUDA pin —
#     bumping torch implies revalidating cu130 ABI against everything else.
#
# v8.1 changes vs v8 (2026-05-06):
#   - BUMPED vLLM v0.20.0 → v0.20.1. Patch release with several non-DeepSeek
#     fixes that hit our active profiles: PTX `cvt` for FP32→FP4 conversion
#     (#41015) speeds NVFP4 dequant on every NVFP4 weight; CUDA-graph
#     max_num_batched_token capture fix (#40734); num_gpu_blocks_override
#     vs max_model_len reconciliation (#41069); cumem expandable_segments
#     auto-disable (#40812); reasoning-parser kwargs propagated to structured
#     output (#41199).
#   - BUMPED FlashInfer v0.6.9 → v0.6.10. NVFP4 KV cache for prefill+attention
#     (PR #3097, all arch ≥ SM80) — opens a parallel option to TurboQuant K8V4
#     for evaluation; autotuner hybrid token bucketing + missing
#     routing_replay_out arg fix (PR #3115) — autotuner runs hot on Omni since
#     v8 dropped the disable-workaround; vLLM OOB fix (PR #2762); trtllm-gen
#     FMHA SWA cubin update (PR #3089); CuTe DSL FMHA prefill cubin (PR #3039).
#   - BUMPED flash-attn-4 4.0.0b10 → 4.0.0b12 (b11 released 2026-04-29 and b12
#     released 2026-05-06; both bundled in this staging). b11 added first-class
#     head_dim=256 forward+backward in CUTE DSL (PR #2412); 3–9% hd256 perf
#     gain from exp2 FMA emulation (PR #2488); SM100 MLA stream fix (PR #2505);
#     SM100 empty-tile gO None guard (PR #2504). b12 carries the post-b11 fix
#     tail. Direct wins for the Qwen3.6 head_dim=256 line.
#   - BUMPED nvidia-cudnn-cu13 9.20.0.48 → 9.21.1.3 (both stages). Two minor
#     bumps. Safe now that v8 fixed the apt-vs-pip mismatch root cause; cuDNN
#     is the canary so smoke-test Omni audio after promotion.
#   - BUMPED apache-tvm-ffi 0.1.10 → 0.1.11. Single patch release.
#   - BUMPED transformers 5.7.0 → 5.8.0. Rolling minor update for the
#     post-5.7.0 fix tail. Smoke-test all profiles after the build to confirm
#     no regression in the 5.7.0-known-good areas (Qwen3.5 GDN, Gemma4 rotary,
#     continuous batching ≥16K, NVFP4+torchao).
#   - BUMPED nvidia-cutlass-dsl 4.4.2 → 4.5.0 stable. 4.5.0 stable shipped
#     2026-05-XX. The release-line headline gain — "optimal code generation
#     with CUDA toolkit 13.2" — does NOT apply at our CUDA 13.0.3, but the
#     accumulated 4.4.2 → 4.5.0 bug fixes do, and pinning to stable keeps us
#     on a non-pre-release line. Re-evaluate the codegen win after JetPack 7.2
#     brings CUDA 13.2.
#   - BUMPED fastsafetensors 0.3 → 0.3.1. Single patch release.
#   - HELD CUDA at 13.0.3-ubuntu24.04. JetPack 7.1 ships CUDA 13.0; container
#     CUDA ahead of host driver adds avoidable risk. Bump when JetPack 7.2
#     lands.
#   - HELD torch nightly at 2026-04-26+cu130. Tied to the CUDA pin —
#     bumping torch implies revalidating cu130 ABI against everything else.
#   - HELD nvidia-nvshmem-cu13 at 3.6.5 (already latest).
#   - HELD instanttensor at 0.1.8 (already latest).
#   - HELD triattention at @325297218a (HEAD is one README-only commit ahead).
#
# v8 changes vs v7 (2026-04-29):
#   - DROPPED apt libcudnn9-cuda-13 in both stages. v7 had apt cuDNN 9.21.1
#     and pip cuDNN 9.20.0 (transitive via torch nightly) installed
#     simultaneously. nvidia-runtime ld.so.cache prefers the apt copy, while
#     PyTorch's own runtime checks the pip version it was built against —
#     this surfaced as cuDNN SUBLIBRARY_VERSION_MISMATCH on Nemotron 3 Nano
#     Omni's FlashInfer autotuner path. Workaround in v7 was profile-level
#     `--kernel-config '{"enable_flashinfer_autotune": false}'`. v8 fixes
#     it at the image level by relying solely on pip nvidia-cudnn-cu13.
#   - ADDED audio dependencies (librosa, soundfile + apt ffmpeg) so Nemotron
#     Omni's audio modality boots without a vllm[audio] post-install.
#   - vLLM and FlashInfer pins UNCHANGED — v7 stack is proven on every
#     active profile; v8 is a hygiene + targeted-fixes release, not a major
#     version bump. Bumping vLLM should be a separate v9 once a clean
#     upstream release lands with all v0.20.0 + post-release fixes we depend on.
#   - BUMPED transformers 5.6.2 → 5.7.0 for: Qwen3.5 GDN linear-attention cached
#     forward correctness fix, Gemma4 rotary kernel + config-driven inference
#     fixes, continuous batching memory/KV-dedup fixes ≥16K (we run 64K),
#     NVFP4+torchao serialization fix. All directly relevant to active profiles.
#
# Recommended invocation for the v9 image:
#   ./build-vllm.sh --vllm-ref v0.22.0 --flashinfer-ref v0.6.12
#
# Why those pins (researched 2026-05-21):
#   - vLLM v0.22.0 (tagged 2026-05-29) — major bump skipping v0.21 as a
#     staging waypoint. The headline wins for our profile (BF16 weights +
#     FP8 KV + Qwen3-VL family) are the batch-invariant Cutlass FP8 path
#     (+28.9% E2E latency on the FP8-KV path), CutlassFP8 padding pre-
#     processing (+13.5% TTFT), Qwen3.5 ViT full CUDA graph (direct cosmos-
#     reason2-8b vision-tower benefit), and the stream-aware allocator free
#     callback (memory fragmentation fix for the long-running gateway
#     workload). Also lands the carried-forward 0.21 set: FP8-on-Thor
#     formalization (PR #39712, removes runtime SM-guard workarounds in
#     launch.sh), streaming tool dispatch primitives (#40700, #41110 —
#     upstream basis for Bridge Tier 1.1 work), XGrammar 0.2.0 structural
#     tags for strict tool calling (#40894), Qwen3-VL deepstack heavy-load
#     fix (matches cosmos-reason2-8b production).
#   - FlashInfer v0.6.12 (released 2026-05-29) — XQA kernel fixes for
#     multi-iteration scenarios is the directly relevant change: connects
#     to the FlashRT-on-Thor transferable optimization identified during
#     audit (FlashRT vendored a FlashInfer XQA native FP8-KV kernel for
#     long-context decode; the upstream fix may make that path reachable
#     through vLLM's backend selection on cosmos-reason2-8b FP8-KV decode).
#     Per-token NVFP4 quantization kernel optimization helps all our NVFP4
#     profiles. NOTE: we override vLLM 0.22's bundled 0.6.11.post2 pin to
#     0.6.12; standard wheel-cache override pattern (see PATCHES-AUDIT.md).
#   - flash-attn-4==4.0.0b15 (pinned in runner stage below). b15 (2026-05-27)
#     explicitly extends SM gating to recognize SM110a as part of the
#     Blackwell family ("Include sm_110 in Blackwell-family arch gating").
#     First commit-level signal of first-class Thor support — resolves any
#     kernel-selection fallback cases that previously surfaced as opaque
#     perf cliffs. b13/b14 carry varlen blocksparsity, varlen-paged-KV
#     split-config fixes — rolling fix tail.
#   - transformers==5.9.0 (released 2026-05-20) — "support for custom field
#     prefilling (reasoning_content, thinking, etc.) in chat template
#     handling" is the template-side primitive for the Dynamo-style reasoning
#     preservation pattern Bridge Tier 2 work targets. With 5.9.0 the bridge
#     can opt into reasoning_content prefill via chat_template_kwargs
#     (subject to per-model template support).
#   - nvidia-cutlass-dsl==4.5.2 (pinned in runner stage below; bumped from
#     v8.1's 4.5.0). Two patch releases of accumulated bug fixes on the
#     4.5.0 stable line. Headline codegen gain still gated on CUDA 13.2 /
#     JetPack 7.2.
#
# Usage:
#   ./build-vllm.sh --vllm-ref v0.22.0 --flashinfer-ref v0.6.12  # canonical v9 build
#   ./build-vllm.sh --vllm-ref main                              # bleeding edge, NOT recommended
#   ./build-vllm.sh --build-jobs 8                               # lower parallelism if constrained

# ── Build tunables ──────────────────────────────────────────────────
# Thor has 14 ARM cores (Cortex-A78AE). Default to full parallelism. With 128 GiB
# unified memory, peak CUDA compile RSS at 14 concurrent jobs stays well under
# 30 GiB. Drop to 8-10 only if rebuilding while serving a model.
ARG BUILD_JOBS=14
ARG CUDA_BASE=nvidia/cuda:13.0.3-devel-ubuntu24.04

# =========================================================
# STAGE 1 — Base build image
# =========================================================
FROM ${CUDA_BASE} AS base

ARG BUILD_JOBS
ENV MAX_JOBS=${BUILD_JOBS}
ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}
ENV NINJAFLAGS="-j${BUILD_JOBS}"
ENV MAKEFLAGS="-j${BUILD_JOBS}"

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PIP_CACHE_DIR=/root/.cache/pip
ENV UV_CACHE_DIR=/root/.cache/uv
ENV UV_SYSTEM_PYTHON=1
ENV UV_BREAK_SYSTEM_PACKAGES=1
ENV UV_LINK_MODE=copy
ENV VLLM_BASE_DIR=/workspace/vllm

# Tell apt to keep .deb files post-install so the BuildKit cache mount
# below actually accumulates downloads (default noble behavior is to delete).
RUN echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
    > /etc/apt/apt.conf.d/keep-downloaded

# Build dependencies — v8 drops apt libcudnn9-* (was source of the Omni
# SUBLIBRARY_VERSION_MISMATCH crash). cuDNN is supplied via pip's
# nvidia-cudnn-cu13 (transitive through torch nightly + explicit pin below).
#
# Apt cache mount uses the same id `apt-cache-thor` as Dockerfile.trt, so
# package downloads are shared across both image trees. First build of
# either populates the cache; subsequent builds of either reuse it.
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-thor,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-thor,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends --allow-change-held-packages \
    curl vim cmake build-essential ninja-build \
    python3-dev python3-pip git wget \
    libnccl-dev libnccl2 libibverbs1 libibverbs-dev rdma-core \
    ccache \
    && pip install uv

# PyTorch nightly (cu130 — matches host CUDA 13.0 driver, avoids PTX version mismatch).
# Pinned to 2026-04-26 nightly for v7 build, retained through v8 and v8.1. Note:
# vLLM v0.20.x pins torch==2.11.0 stable, but no 2.11.0 stable cu130/aarch64
# wheel exists for Thor — we ride the nightly. The 2026-04-15 nightly used in
# v6 has been pruned from the index, so v6 is no longer rebuildable; v7+ uses
# the 2.13-nightly that is currently live. Triton ships bundled inside the
# torch wheel — no explicit pin needed.
ENV UV_HTTP_TIMEOUT=300
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
     uv pip install \
         "torch==2.13.0.dev20260426+cu130" \
         --index-url https://download.pytorch.org/whl/nightly/cu130 && \
     uv pip install \
         "torchvision==0.27.0.dev20260426+cu130" \
         "torchaudio==2.11.0.dev20260426+cu130" \
         --index-url https://download.pytorch.org/whl/nightly/cu130 && \
     uv pip install "nvidia-nvshmem-cu13==3.6.5" "apache-tvm-ffi==0.1.11" filelock pynvml requests tqdm

# v9: pin pip cuDNN explicitly so it can't drift in the resolver. torch nightly
# pulls nvidia-cudnn-cu13 transitively; pinning here documents the exact build
# version and keeps base+runner stages aligned. Drop or bump only when both
# stages are bumped together. v9 bumps 9.21.1.3 → 9.23.0.39 (current latest).
# vLLM 0.22's transitive cuDNN constraint may override at install time; the
# pin documents our requested version.
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
     uv pip install "nvidia-cudnn-cu13==9.23.0.39"

# Ccache
ENV PATH=/usr/lib/ccache:$PATH
ENV CCACHE_DIR=/root/.ccache
ENV CCACHE_MAXSIZE=50G
ENV CCACHE_COMPRESS=1
ENV CMAKE_CXX_COMPILER_LAUNCHER=ccache
ENV CMAKE_CUDA_COMPILER_LAUNCHER=ccache

WORKDIR $VLLM_BASE_DIR

# Thor = sm110, compute capability 11.0
ARG TORCH_CUDA_ARCH_LIST="11.0a"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
ENV TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas
ENV TRITON_PTXAS_BLACKWELL_PATH=/usr/local/cuda/bin/ptxas


# =========================================================
# STAGE 2 — FlashInfer build
# =========================================================
FROM base AS flashinfer-builder

ARG FLASHINFER_CUDA_ARCH_LIST="11.0a"
ENV FLASHINFER_CUDA_ARCH_LIST=${FLASHINFER_CUDA_ARCH_LIST}
WORKDIR $VLLM_BASE_DIR
ARG FLASHINFER_REF=main
ARG CACHEBUST_FLASHINFER=1

# Clone or update FlashInfer
RUN --mount=type=cache,id=repo-cache,target=/repo-cache \
    cd /repo-cache && \
    if [ ! -d "flashinfer" ]; then \
        echo "Cache miss: Cloning FlashInfer..." && \
        git clone --recursive https://github.com/flashinfer-ai/flashinfer.git; \
        if [ "$FLASHINFER_REF" != "main" ]; then \
            cd flashinfer && git checkout ${FLASHINFER_REF}; \
        fi; \
    else \
        echo "Cache hit: Fetching FlashInfer updates..." && \
        cd flashinfer && \
        git fetch origin && \
        git fetch origin --tags --force && \
        (git checkout --detach origin/${FLASHINFER_REF} 2>/dev/null || git checkout ${FLASHINFER_REF}) && \
        git submodule update --init --recursive && \
        git clean -fdx && \
        git gc --auto; \
    fi && \
    cp -a /repo-cache/flashinfer /workspace/flashinfer

WORKDIR /workspace/flashinfer

# Avoid re-downloading existing cubins (pure build-speed optimization;
# tolerant if upstream artifacts.py changed and patch context no longer matches —
# absence only means we re-fetch cubins, not a build break).
COPY patches/flashinfer_cache.patch .
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    --mount=type=cache,id=ccache,target=/root/.ccache \
    --mount=type=cache,id=cubins-cache,target=/workspace/flashinfer/flashinfer-cubin/flashinfer_cubin/cubins \
    (patch -p1 --forward < flashinfer_cache.patch || \
     echo "flashinfer_cache.patch did not apply cleanly — proceeding without cubin-cache fast path") && \
    sed -i -e 's/license = "Apache-2.0"/license = { text = "Apache-2.0" }/' -e '/license-files/d' pyproject.toml && \
    uv build --no-build-isolation --wheel . --out-dir=/workspace/wheels -v && \
    cd flashinfer-cubin && uv build --no-build-isolation --wheel . --out-dir=/workspace/wheels -v && \
    cd ../flashinfer-jit-cache && uv build --no-build-isolation --wheel . --out-dir=/workspace/wheels -v && \
    cd .. && git rev-parse HEAD > /workspace/wheels/.flashinfer-commit


# =========================================================
# STAGE 3 — FlashInfer wheel export
# =========================================================
FROM scratch AS flashinfer-export
COPY --from=flashinfer-builder /workspace/wheels /


# =========================================================
# STAGE 4 — vLLM build
# =========================================================
FROM base AS vllm-builder

ARG TORCH_CUDA_ARCH_LIST="11.0a"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
WORKDIR $VLLM_BASE_DIR

ARG CACHEBUST_VLLM=1
ARG VLLM_REF=main

# Clone or update vLLM
RUN --mount=type=cache,id=repo-cache,target=/repo-cache \
    cd /repo-cache && \
    if [ ! -d "vllm" ]; then \
        echo "Cache miss: Cloning vLLM..." && \
        git clone --recursive https://github.com/vllm-project/vllm.git; \
        if [ "$VLLM_REF" != "main" ]; then \
            cd vllm && git checkout ${VLLM_REF}; \
        fi; \
    else \
        echo "Cache hit: Fetching vLLM updates..." && \
        cd vllm && \
        git fetch origin && \
        git fetch origin --tags --force && \
        (git checkout --detach origin/${VLLM_REF} 2>/dev/null || git checkout ${VLLM_REF}) && \
        git submodule update --init --recursive && \
        git clean -fdx && \
        git gc --auto; \
    fi && \
    cp -a /repo-cache/vllm $VLLM_BASE_DIR/

WORKDIR $VLLM_BASE_DIR/vllm

# Optional: apply specific vLLM PRs at build time
ARG VLLM_PRS=""
RUN if [ -n "$VLLM_PRS" ]; then \
        echo "Applying PRs: $VLLM_PRS"; \
        for pr in $VLLM_PRS; do \
            echo "Fetching and applying PR #$pr..."; \
            curl -fL "https://github.com/vllm-project/vllm/pull/${pr}.diff" | git apply -v --exclude='tests/*' || \
            (echo "WARNING: PR #$pr partial apply (excluding tests)..." && \
             curl -fL "https://github.com/vllm-project/vllm/pull/${pr}.diff" | git apply --reject -v 2>&1; true); \
        done; \
    fi

# Prepare build requirements
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    python3 use_existing_torch.py && \
    sed -i "/flashinfer/d" requirements/cuda.txt && \
    for f in requirements/test.txt requirements/test/cuda.txt; do \
        [ -f "$f" ] && sed -i '/^triton\b/d; /^fastsafetensors\b/d' "$f" || true; \
    done && \
    if [ -f requirements/build.txt ]; then \
        uv pip install -r requirements/build.txt; \
    else \
        uv pip install -r requirements/build/cuda.txt; \
    fi

# Apply build-time patches (conditional — skip if already fixed upstream)
# Copy entire patches dir; vllm_*.patch files are optional
COPY patches/ /tmp/patches/
RUN for p in /tmp/patches/vllm_*.patch; do \
        [ -f "$p" ] || continue; \
        echo "Applying $(basename $p)..."; \
        patch -p1 < "$p" || echo "Patch $(basename $p) not applicable, skipping"; \
    done

# SM110 (Thor) CMakeLists.txt arch lists check — vLLM v0.20.0 PR #39233
# made sm_110 a first-class build target; FP4_ARCHS, SCALED_MM_ARCHS,
# MLA_ARCHS, and MoE arch lists all natively include "11.0f". We verify
# (informational) but do NOT modify — the prior strip-and-restore approach
# was for v0.19 and is no longer correct. Audit: docker/PATCHES-AUDIT.md.
RUN echo "Verifying SM110 arch inclusion in CMakeLists.txt..." && \
    echo "  FP4_ARCHS 11.0f count: $(grep -c 'FP4_ARCHS.*11\.0f' CMakeLists.txt || echo 0)" && \
    echo "  SCALED_MM_ARCHS 11.0f count: $(grep -c 'SCALED_MM_ARCHS.*11\.0f' CMakeLists.txt || echo 0)" && \
    echo "  MLA_ARCHS 11.0f count: $(grep -c 'MLA_ARCHS.*11\.0f' CMakeLists.txt || echo 0)" && \
    echo "  Total 11.0f: $(grep -c '11\.0f' CMakeLists.txt || echo 0)"

# MoE backend selection on SM110 — informational verification only (v7+).
#
# vLLM v0.20.x has TWO FlashInfer MoE backend families:
#   1. FlashInfer CUTLASS MoE  (vllm/.../flashinfer_cutlass_moe.py)
#         — already includes SM110 in its family-capability gate upstream.
#   2. FlashInfer TRT-LLM Gen MoE (vllm/.../experts/trtllm_{bf16,fp8,mxfp4,nvfp4}_moe.py)
#         — gate is `is_device_capability_family(100)` only; rejects SM110.
#
# All our active profiles set:
#     VLLM_USE_FLASHINFER_MOE_FP4=1
#     VLLM_FLASHINFER_MOE_BACKEND=latency
# which select the CUTLASS MoE path, so the TRT-LLM Gen rejection does NOT
# affect them — vLLM falls back to CUTLASS MoE (SM110-supported) cleanly.
#
# We INTENTIONALLY do NOT patch the TRT-LLM Gen gate in v7 because:
#   (a) our profiles don't use that path,
#   (b) we have no evidence TRT-LLM Gen kernels are actually safe on SM110a
#       (the gate guards against this — opening it might unlock runtime crashes),
#   (c) the v6 patch silently no-op'd on v0.20.0's split files anyway, so
#       v6's measured perf was already with TRT-LLM Gen DISABLED on SM110.
#
# If a future profile needs TRT-LLM Gen MoE on SM110, add a targeted patch
# with offline pre-validation against the exact upstream source. See
# docker/PATCHES-AUDIT.md for the v6→v7 transition history.
RUN python3 - <<'PYEOF'
import pathlib
verify = "vllm/model_executor/layers/fused_moe/flashinfer_cutlass_moe.py"
trtllm_files = [
    "vllm/model_executor/layers/fused_moe/experts/trtllm_bf16_moe.py",
    "vllm/model_executor/layers/fused_moe/experts/trtllm_fp8_moe.py",
    "vllm/model_executor/layers/fused_moe/experts/trtllm_mxfp4_moe.py",
    "vllm/model_executor/layers/fused_moe/experts/trtllm_nvfp4_moe.py",
]
p = pathlib.Path(verify)
if p.exists() and "is_device_capability_family(110)" in p.read_text():
    print(f"VERIFIED {verify}: SM110 family check present (CUTLASS MoE path is SM110-ready)")
else:
    print(f"NOTE {verify}: SM110 check missing or file moved — CUTLASS MoE may need a patch")
for f in trtllm_files:
    p = pathlib.Path(f)
    status = "exists (SM110 NOT patched — falls back to CUTLASS path)" if p.exists() else "missing"
    print(f"INFO  {f}: {status}")
print()
print("MoE backend selection: CUTLASS (SM110-ready upstream) is the active path")
print("via VLLM_USE_FLASHINFER_MOE_FP4=1 + VLLM_FLASHINFER_MOE_BACKEND=latency.")
PYEOF

# NOTE: FA2 SM110 patch removed — confirmed Xid 43 (GPU hang) at runtime.
# FA2 kernels use SM80-specific shared memory patterns that cause hardware
# faults on SM110 even when compiled with native cubins.
#
# FA4 handles SM110 fine, including head_dim=256 (empirically validated
# 2026-04-26 on both Qwen3.6-27B-FP8 and Qwen3.6-35B-A3B-FP8 — the prior
# "head_dim=256 hits TMEM limit" claim in earlier docs was wrong; FA4 runs
# the full-attention layers cleanly through its SM_100 dispatch path on Thor).
# FA4 still does NOT support FP8 KV cache on Blackwell pre-beta10 — beta10
# (pinned below) ships FP8 e4m3/e5m2 forward kernels (PR #2109).
#
# FlashInfer remains the right choice for FP8 KV + non-DFlash workloads;
# flash_attn (FA4) is preferred for DFlash speculative decoding paths.

# Compile vLLM wheel
RUN --mount=type=cache,id=ccache,target=/root/.ccache \
    --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    uv build --no-build-isolation --wheel . --out-dir=/workspace/wheels -v && \
    git rev-parse HEAD > /workspace/wheels/.vllm-commit


# =========================================================
# STAGE 5 — vLLM wheel export
# =========================================================
FROM scratch AS vllm-export
COPY --from=vllm-builder /workspace/wheels /


# =========================================================
# STAGE 6 — Runner (final image)
# =========================================================
FROM ${CUDA_BASE} AS runner

ARG BUILD_JOBS=14
ENV MAX_JOBS=${BUILD_JOBS}
ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}
ENV NINJAFLAGS="-j${BUILD_JOBS}"
ENV MAKEFLAGS="-j${BUILD_JOBS}"

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV VLLM_BASE_DIR=/workspace/vllm

ENV PIP_CACHE_DIR=/root/.cache/pip
ENV UV_CACHE_DIR=/root/.cache/uv
ENV UV_SYSTEM_PYTHON=1
ENV UV_BREAK_SYSTEM_PACKAGES=1
ENV UV_LINK_MODE=copy

# Tell apt to keep .deb files post-install so the BuildKit cache mount
# below actually accumulates downloads (default noble behavior is to delete).
RUN echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
    > /etc/apt/apt.conf.d/keep-downloaded

# Runtime dependencies — v8 drops apt libcudnn9-cuda-13 (see header for why).
# Adds ffmpeg + libsndfile for Nemotron Omni audio decode (librosa/soundfile
# need the system libs to actually open audio files).
# Apt cache mount shares with Dockerfile.trt via the same id `apt-cache-thor`.
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-thor,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-thor,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends --allow-change-held-packages \
    python3 python3-pip python3-dev vim curl git wget \
    libnccl-dev libnccl2 libibverbs1 libibverbs-dev rdma-core \
    libxcb1 \
    ffmpeg libsndfile1 \
    && pip install uv

WORKDIR $VLLM_BASE_DIR

# Tiktoken encodings (used by many models' tokenizers)
RUN mkdir -p tiktoken_encodings && \
    wget -O tiktoken_encodings/o200k_base.tiktoken \
         "https://openaipublic.blob.core.windows.net/encodings/o200k_base.tiktoken" && \
    wget -O tiktoken_encodings/cl100k_base.tiktoken \
         "https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken"

ARG PRE_TRANSFORMERS=1
ENV UV_HTTP_TIMEOUT=300

# PyTorch (cu130 — matches host CUDA 13.0 driver) — pinned to 2026-04-26 nightly.
# v7 pin retained through v8 and v8.1 (still the latest live nightly with all
# our fixes; bumping torch is coupled to a CUDA bump and deferred to v9).
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
     uv pip install \
         "torch==2.13.0.dev20260426+cu130" \
         --index-url https://download.pytorch.org/whl/nightly/cu130 && \
     uv pip install \
         "torchvision==0.27.0.dev20260426+cu130" \
         "torchaudio==2.11.0.dev20260426+cu130" \
         --index-url https://download.pytorch.org/whl/nightly/cu130 && \
     uv pip install "nvidia-nvshmem-cu13==3.6.5" "apache-tvm-ffi==0.1.11"

# v9: pin pip cuDNN to match the base stage. Same version both sides keeps the
# torch ABI happy and avoids any chance of a runtime/build-time mismatch.
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
     uv pip install "nvidia-cudnn-cu13==9.23.0.39"

# Install FlashInfer + vLLM wheels (bind-mounted from host ./wheels/)
# Exclude flashinfer_cubin wheel: precompiled cubins are downloaded from upstream
# and target sm100f — they crash on sm110 (Thor).
# INCLUDE flashinfer_jit_cache: JIT-compiled .so files are built with
# FLASHINFER_CUDA_ARCH_LIST=11.0a and contain valid sm_110a code.
# This enables the FlashInfer attention backend on Thor.
# With --tf5 (PRE_TRANSFORMERS=1, the default): override vLLM's and compressed-tensors'
# transformers<5 constraint, then explicitly install transformers==5.9.0 (v9).
# transformers 5.2.0: first native Qwen3.5 support.
# transformers 5.3.0: NVFP4 Blackwell quantization integration, Qwen3.5 bug fixes.
# transformers 5.4.0: Qwen3.5 classification, FP8 grouped matmul speedup.
# transformers 5.5.0: Gemma 4 model class (Gemma4ForConditionalGeneration),
#   Gemma4Config, Gemma4VisionConfig, Gemma4AudioConfig, Gemma4Processor.
# transformers 5.6.x: post-5.5 Qwen3.6-MoE / Gemma 4 / NVFP4 fixes.
# transformers 5.7.0 (v8 bump, 2026-04-28): Qwen3.5 GDN linear-attention cached
#   multi-token forward fix (correctness), Gemma4 rotary kernel incompatibility
#   fix + config-driven inference, continuous batching KV-dedup and memory
#   estimation fixes for sequences ≥16K (we run 64K), NVFP4+torchao
#   serialization fix.
# transformers 5.8.0/5.8.1 (v8.1 bump tail, 2026-05-13): rolling fixes — DeepSeek
#   V4 integration polish, WeightConverter regex fixes. No regressions in our
#   5.7.0-known-good areas.
# transformers 5.9.0 (v9 staging bump, 2026-05-20): "support for custom field
#   prefilling (reasoning_content, thinking, etc.) in chat template handling" —
#   template-side primitive for Dynamo-style reasoning-block preservation that
#   Bridge Tier 2 work targets. Bridge can opt into reasoning_content prefill
#   via chat_template_kwargs (subject to per-model template support; Qwen3-VL
#   template support TBD — verify on cosmos-reason2-8b after build).
RUN --mount=type=bind,source=wheels,target=/workspace/wheels \
    --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    if [ "$PRE_TRANSFORMERS" = "1" ]; then \
        echo "transformers>=5.0.0" > /tmp/tf-override.txt && \
        echo "torch==2.13.0.dev20260426+cu130" >> /tmp/tf-override.txt && \
        uv pip install $(ls /workspace/wheels/*.whl | grep -v flashinfer_cubin) --override /tmp/tf-override.txt && \
        uv pip install "transformers==5.9.0" --override /tmp/tf-override.txt; \
    else \
        uv pip install $(ls /workspace/wheels/*.whl | grep -v flashinfer_cubin); \
    fi
# v9 fix (2026-05-30): pin torch in the override file so vLLM 0.22's transitive
# constraint can't downgrade torch 2.13.0.dev20260426+cu130 → torch 2.10.0 stable.
# The downgrade broke vllm._C at import time because the C++ extension was compiled
# against 2.13's libtorch_cuda.so layout; 2.10 stable ships a different layout
# (no libtorch_cuda.so at the expected path). Without this override the runner
# stage produces an image that ImportErrors on first python -m vllm.entrypoints.*
# call. Override is the same uv-level mechanism we already use for transformers.

# Runtime environment
ARG TORCH_CUDA_ARCH_LIST="11.0a"
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
ARG FLASHINFER_CUDA_ARCH_LIST="11.0a"
ENV FLASHINFER_CUDA_ARCH_LIST=${FLASHINFER_CUDA_ARCH_LIST}
ENV TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas
ENV TRITON_PTXAS_BLACKWELL_PATH=/usr/local/cuda/bin/ptxas
ENV TIKTOKEN_ENCODINGS_BASE=$VLLM_BASE_DIR/tiktoken_encodings
ENV PATH=$VLLM_BASE_DIR:$PATH

# Runtime mods directory — applied at container start via entrypoint
COPY mods/ /workspace/mods/

# No Ray — single-node only.
# - fastsafetensors/instanttensor: fast model loading (--load-format instanttensor)
# - triattention: KV cache compression via trigonometric frequency-domain scoring
#   (vLLM plugin — transparent, up to 10.7x KV memory reduction for long reasoning)
# - flash-attn-4 beta15: FA4 with explicit SM110a recognition in the Blackwell
#   arch-gating path. Beta15 (2026-05-27) added "Include sm_110 in Blackwell-
#   family arch gating" — first commit-level signal of first-class Thor support.
#   Resolves kernel-selection fallback cases that previously surfaced as opaque
#   perf cliffs. Earlier b13/b14 carry varlen blocksparsity, varlen-paged-KV
#   split-config fixes — rolling fix tail. Carried forward from v8.1 baseline:
#   first-class head_dim=256 forward+backward in CUTE DSL (b11 PR #2412), 3-9%
#   hd256 perf gain via exp2 FMA emulation (b11 PR #2488), SM100 MLA stream +
#   empty-tile gO None fixes (b11 PRs #2505, #2504), SM100 FP8 e4m3/e5m2 forward
#   (b10 PR #2109). Enables --attention-backend flash_attn for DFlash on SM110
#   with head_dim=256.
#   Requires nvidia-cutlass-dsl >= 4.4.x. Bumped to 4.5.2 in v9 (two patch
#   releases since v8.1's 4.5.0). The 4.5.0 release-line "optimal code
#   generation with CUDA 13.2" headline does NOT apply at our CUDA 13.0.3,
#   but the accumulated 4.4.2 → 4.5.0 → 4.5.2 bug fixes do. Revisit
#   measurable codegen win after JetPack 7.2.
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    uv pip install "fastsafetensors==0.3.2" "instanttensor==0.1.9" && \
    uv pip install "triattention @ git+https://github.com/WeianMao/triattention.git@325297218a" && \
    uv pip install "flash-attn-4==4.0.0b15" "nvidia-cutlass-dsl==4.5.2"

# v8: vLLM audio extras — librosa + soundfile cover Nemotron 3 Nano Omni's
# audio modality (Parakeet encoder feed). audioread is librosa's fallback
# decoder. Without these, the Omni audio path fails on first audio request.
# apt's ffmpeg + libsndfile1 (above) supply the system codecs they wrap.
RUN --mount=type=cache,id=uv-cache,target=/root/.cache/uv \
    uv pip install "librosa>=0.10.2" "soundfile>=0.12.1" "audioread>=3.0.1"

# flash_attn shim: merge vendored vllm_flash_attn modules into the flash-attn-4
# package. flash-attn-4 only provides cute/, but vLLM also imports flash_attn.ops
# (for rotary embeddings) and flash_attn_interface (for varlen_fwd). Copy missing
# modules from the vendored copy.
RUN SITE=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
    FA="$SITE/flash_attn" && \
    VFA="$SITE/vllm/vllm_flash_attn" && \
    if [ -d "$FA" ] && [ -d "$VFA" ]; then \
        for subdir in ops; do \
            if [ ! -e "$FA/$subdir" ] && [ -d "$VFA/$subdir" ]; then \
                cp -r "$VFA/$subdir" "$FA/$subdir" && \
                echo "Copied $subdir from vllm_flash_attn to flash_attn"; \
            fi; \
        done; \
        for pyfile in flash_attn_interface.py; do \
            if [ ! -e "$FA/$pyfile" ] && [ -f "$VFA/$pyfile" ]; then \
                cp "$VFA/$pyfile" "$FA/$pyfile" && \
                echo "Copied $pyfile from vllm_flash_attn to flash_attn"; \
            fi; \
        done; \
    elif [ ! -e "$FA" ] && [ -d "$VFA" ]; then \
        ln -s "$VFA" "$FA" && \
        echo "Created flash_attn symlink (flash-attn-4 not installed)"; \
    else \
        echo "flash_attn shim: nothing to do"; \
    fi

# Build metadata (generated by build-vllm.sh)
COPY build-metadata.yaml /workspace/build-metadata.yaml

# Default entrypoint: apply mods then exec into vllm
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh
ENTRYPOINT ["/workspace/entrypoint.sh"]
